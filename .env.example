# =====================================================
# 环境变量配置模板
# 使用说明: 复制此文件为 .env 并填入实际值
# =====================================================

# =====================================================
# 运行环境配置
# =====================================================
ENV=local

# =====================================================
# TimescaleDB 数据库配置
# =====================================================
# 数据库密码（生产环境请使用强密码）
POSTGRES_PASSWORD=postgres

# 数据库连接信息
TIMESCALEDB_HOST=127.0.0.1
TIMESCALEDB_PORT=5432
TIMESCALEDB_NAME=crypto_data
TIMESCALEDB_USER=postgres

# 连接池配置
TIMESCALEDB_POOL_SIZE=10
TIMESCALEDB_MAX_OVERFLOW=20
TIMESCALEDB_POOL_TIMEOUT=30
TIMESCALEDB_POOL_RECYCLE=3600

# =====================================================
# 飞书机器人配置
# =====================================================
# 飞书机器人 ID（用于告警通知）
LARKBOT_ID=e15eaffe-05db-48f2-8059-a78b1beff8c9

# 飞书 Webhook URL（完整URL或使用LARKBOT_ID自动构建）
# 格式: https://open.larksuite.com/open-apis/bot/v2/hook/{YOUR_BOT_ID}
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/e15eaffe-05db-48f2-8059-a78b1beff8c9

# 飞书告警邮箱（用于@人）
LARK_ALERT_EMAIL=your.email@example.com

# =====================================================
# Redis 配置
# =====================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=@f4@c@EtUntE4

# Redis 数据库索引
REDIS_DB=0

# =====================================================
# 实时分析服务配置（模块3使用）
# =====================================================
# WebSocket 重连配置
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECT_ATTEMPTS=10

# 数据缓冲配置
KLINE_BUFFER_SIZE=1000
KLINE_FLUSH_INTERVAL=5

# 分析配置
ANALYSIS_SYMBOLS_COUNT=200
ANALYSIS_TIMEFRAMES=5m,1h,4h

# 分析工作线程数（Phase 1.5 性能优化）
# 推荐值: 5-6个线程（提供200%+容量余量）
# 计算公式: CPU核心数 × 1.5 - 2（预留资源给其他线程）
ANALYSIS_WORKERS=5

# 分析结果批量写入配置（Phase 2 性能优化）
# 批量大小: 每批写入的记录数（推荐100）
ANALYSIS_RESULT_BATCH_SIZE=100
# 批量超时: 批量写入的超时时间（秒，推荐2.0）
ANALYSIS_RESULT_BATCH_TIMEOUT=2.0

# 告警配置
ALERT_ZSCORE_THRESHOLD=2.0
ALERT_CORRELATION_THRESHOLD=0.7
